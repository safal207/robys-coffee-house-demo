{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/robys-coffee-house-demo/blob/main/qa/causal-refactoring/robys-fcr-v0.1.schema.json",
  "title": "Roby's Fractal Causal Refactoring v0.1",
  "description": "Shape contract for an evidence-gated Roby's menu-to-visit causal model. The dependency-free repository verifier is normative for fail-closed semantic checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "business_context",
    "visible_symptom",
    "first_meaningful_divergence",
    "root_rule",
    "unsafe_patches",
    "refactor",
    "measurement_contract",
    "experiment",
    "decision_gates",
    "claim_boundary",
    "open_business_inputs",
    "next_falsifiable_question"
  ],
  "properties": {
    "schema": {
      "const": "robys-fractal-causal-refactoring/v0.1"
    },
    "status": {
      "const": "draft-operational-contract"
    },
    "business_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "venue",
        "location",
        "repository",
        "customer_languages",
        "current_surfaces",
        "non_capabilities"
      ],
      "properties": {
        "venue": {
          "const": "Roby's Coffee House"
        },
        "location": {
          "const": "Gazipaşa, Antalya"
        },
        "repository": {
          "const": "safal207/robys-coffee-house-demo"
        },
        "customer_languages": {
          "const": [
            "tr",
            "en",
            "ru"
          ]
        },
        "current_surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "non_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "allOf": [
            {
              "contains": {
                "const": "ordering"
              }
            },
            {
              "contains": {
                "const": "payment"
              }
            },
            {
              "contains": {
                "const": "reservation"
              }
            },
            {
              "contains": {
                "const": "inventory-guarantee"
              }
            }
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "visible_symptom": {
      "$ref": "#/$defs/diagnosis"
    },
    "first_meaningful_divergence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from_state",
        "to_state",
        "statement",
        "why_first",
        "not_at"
      ],
      "properties": {
        "id": {
          "const": "FMD-ROBY-001"
        },
        "from_state": {
          "const": "COMMITMENT"
        },
        "to_state": {
          "const": "ARRIVAL"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "why_first": {
          "type": "string",
          "minLength": 1
        },
        "not_at": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        }
      }
    },
    "root_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "current",
        "replacement"
      ],
      "properties": {
        "id": {
          "const": "RULE-ROBY-001"
        },
        "current": {
          "type": "string",
          "minLength": 1
        },
        "replacement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unsafe_patches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "patch",
          "why_unsafe"
        ],
        "properties": {
          "patch": {
            "type": "string",
            "minLength": 1
          },
          "why_unsafe": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "refactor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principle",
        "preserve",
        "stages",
        "transitions",
        "forbidden_state_substitutions"
      ],
      "properties": {
        "principle": {
          "type": "string",
          "minLength": 1
        },
        "preserve": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "stages": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "transitions": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "forbidden_state_substitutions": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        }
      }
    },
    "measurement_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linkage",
        "metrics",
        "forbidden_substitutions",
        "attribution_window",
        "cost_inputs",
        "privacy_guardrails"
      ],
      "properties": {
        "linkage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "mode",
            "pii_required",
            "display_code_is_proof",
            "required_bindings"
          ],
          "properties": {
            "status": {
              "const": "BLOCKED_PENDING_OWNER_INPUT"
            },
            "mode": {
              "const": "privacy_safe_opaque_token"
            },
            "pii_required": {
              "const": false
            },
            "display_code_is_proof": {
              "const": false
            },
            "required_bindings": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proxies",
            "outcomes",
            "primary"
          ],
          "properties": {
            "proxies": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            },
            "outcomes": {
              "$ref": "#/$defs/nonEmptyUniqueStrings"
            },
            "primary": {
              "const": "net_contribution_per_eligible_session"
            }
          }
        },
        "forbidden_substitutions": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "attribution_window": {
          "const": "OWNER_DEFINED_BEFORE_PILOT"
        },
        "cost_inputs": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "privacy_guardrails": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "candidate_pairing",
        "price_source",
        "hypothesis",
        "baseline",
        "treatment",
        "assignment",
        "primary_metric",
        "secondary_metrics",
        "guardrails",
        "pre_registration_required"
      ],
      "properties": {
        "id": {
          "const": "FCR-ROBY-001"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "candidate_pairing": {
          "type": "string",
          "minLength": 1
        },
        "price_source": {
          "const": "approved menu truth at pilot start"
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "type": "string",
          "minLength": 1
        },
        "treatment": {
          "type": "string",
          "minLength": 1
        },
        "assignment": {
          "const": "randomized_session_or_pre_registered_time_block"
        },
        "primary_metric": {
          "const": "net_contribution_per_eligible_session"
        },
        "secondary_metrics": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "guardrails": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "pre_registration_required": {
          "const": true
        }
      }
    },
    "decision_gates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/decisionGate"
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_status",
        "can_claim",
        "cannot_claim"
      ],
      "properties": {
        "current_status": {
          "const": "MODEL_DEFINED_NOT_EMPIRICALLY_VERIFIED"
        },
        "can_claim": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "cannot_claim": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        }
      }
    },
    "open_business_inputs": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "next_falsifiable_question": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "observed_proxies",
        "unproven_outcomes"
      ],
      "properties": {
        "id": {
          "const": "SYM-ROBY-001"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "observed_proxies": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "unproven_outcomes": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "evidence_required",
        "claim_allowed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "enum": [
            "digital",
            "physical",
            "operational",
            "economic",
            "decision"
          ]
        },
        "evidence_required": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "claim_allowed": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "gate"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "gate": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decisionGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "result",
        "requires"
      ],
      "properties": {
        "id": {
          "enum": [
            "MODEL",
            "PILOT",
            "SCALE",
            "ROLLBACK"
          ]
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "requires": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        }
      }
    }
  }
}
