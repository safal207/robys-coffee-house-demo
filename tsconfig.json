{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2020"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@robys/order": [
        "src/order-store.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "menu-catalog.d.ts"
  ]
}
