<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Robys" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/robys_white</item>
        <item name="android:navigationBarColor">@color/robys_white</item>
        <item name="android:windowBackground">@color/robys_white</item>
        <item name="android:colorAccent">@color/robys_red</item>
        <item name="android:windowSplashScreenBackground">@color/robys_white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_robys_mark</item>
        <item name="android:windowSplashScreenAnimationDuration">180</item>
    </style>
</resources>
