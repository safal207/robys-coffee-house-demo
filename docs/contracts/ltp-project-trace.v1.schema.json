{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robys.example/contracts/ltp-project-trace.v1.schema.json",
  "title": "Robis LTP project trace event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "run_id",
    "agent_id",
    "event_id",
    "sequence",
    "timestamp",
    "source",
    "action",
    "decision",
    "baseline_status",
    "constraint_digest",
    "source_payload_digest",
    "redacted_payload_digest",
    "previous_event_digest",
    "parent_event_id",
    "authorization_event_id",
    "critical_action",
    "protected_effect",
    "authorized",
    "committed",
    "resume",
    "trace_complete",
    "redaction_status",
    "event_digest"
  ],
  "properties": {
    "schema_version": { "const": "ltp-project-trace.v1" },
    "trace_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "source": { "enum": ["SYSTEM", "HUMAN", "CI", "REPOSITORY", "WEB", "TOOL", "MODEL"] },
    "action": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["ALLOW", "BLOCK", "DENY", "HOLD", "OBSERVE"] },
    "baseline_status": { "enum": ["MATCH", "DRIFT"] },
    "constraint_digest": { "$ref": "#/$defs/sha256" },
    "source_payload_digest": { "$ref": "#/$defs/sha256" },
    "redacted_payload_digest": { "$ref": "#/$defs/sha256" },
    "previous_event_digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
    "parent_event_id": { "type": ["string", "null"] },
    "authorization_event_id": { "type": ["string", "null"] },
    "critical_action": { "type": "boolean" },
    "protected_effect": { "type": "boolean" },
    "authorized": { "type": "boolean" },
    "committed": { "type": "boolean" },
    "resume": { "type": "boolean" },
    "trace_complete": { "type": "boolean" },
    "redaction_status": { "const": "clean" },
    "event_digest": { "$ref": "#/$defs/sha256" },
    "payload": {},
    "metadata": { "type": "object" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
